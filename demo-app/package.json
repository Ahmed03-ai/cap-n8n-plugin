{
  "name": "demo-app",
  "version": "1.0.0",
  "workspaces": [
    "../cap-n8n-plugin"
  ],
  "dependencies": {
    "@sap/cds": "^9.9.1",
    "cap-n8n-plugin": "*"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "n8n": {
        "impl": "../cap-n8n-plugin/lib/N8nWorkflowService.js",
        "credentials": {
          "baseUrl": "http://localhost:5678",
          "apiKey": "{env.N8N_API_KEY}"
        }
      }
    },
    "server": {
      "port": 3000
    }
  }
}
