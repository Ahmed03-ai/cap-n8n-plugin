    {
      "parameters": {
        "promptType": "define",
        "text": "=You enrich book metadata for a CAP Book entity.\n\nInput:\nTitle: {{ $('CAP Book Event').item.json.body.title }}\nCurrent description: {{ $('CAP Book Event').item.json.body.description }}\nCurrent author ID: {{ $('CAP Book Event').item.json.body.authorId }}\nCurrent genre ID: {{ $('CAP Book Event').item.json.body.genreId }}\n\nTask:\nWrite an improved book description for this book.\n\nRules:\n- Return only the improved description as plain text.\n- Keep it factual and concise.\n- Do not mention that you are an AI.\n- Do not include JSON, markdown, labels, bullets, or quotes.\n- Length: 6 to 8 sentences.\n- Preserve the original meaning, but add useful context if obvious from the title and description.",
        "options": {}
      },
      "id": "2824063b-59a6-4f93-887d-0ce5fe217e02",
