# CAP n8n Integration environment example
#
# Copy values into your local shell or an ignored .env file if your tooling loads one.
# Keep real secrets out of commits. Values below are empty, localhost defaults, or
# angle-bracket placeholders only.

# CAP demo/mock
CDS_ENV=development
N8N_KIND=mock
SAP_CAP_BASE_URL=http://host.docker.internal:3000
SAP_CAP_USERNAME=alice
SAP_CAP_PASSWORD=<local-demo-password>

# local n8n webhook
N8N_KIND=webhook
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=<local-n8n-api-key>
N8N_TIMEOUT_MS=10000
N8N_RETRIES=3
N8N_RETRY_DELAY_MS=250

# real n8n custom-node E2E
N8N_REVIEW_BASE_URL=http://localhost:5678
N8N_REVIEW_USER=<operator-local-review-user>
N8N_REVIEW_PASSWORD=<operator-local-review-password>
N8N_CUSTOM_EXTENSIONS=/home/node/.n8n/custom

# cancellation stop API
N8N_CANCEL_SUPPORTED=false
N8N_CANCEL_API_BASE_URL=http://localhost:5678
N8N_CANCEL_WORKFLOW_ID=cap-cancel-stoppable

# cloud n8n
N8N_CLOUD_BASE_URL=https://<your-n8n-host>
N8N_CLOUD_API_KEY=<cloud-n8n-api-key>

# BTP advisory
BTP_CAP_BASE_URL=https://<cap-app-route>
BTP_N8N_BASE_URL=https://<n8n-route>
BTP_DESTINATION_NAME=<btp-destination-name>
BTP_SECRET_STORE=<btp-secret-store-or-service-binding>
